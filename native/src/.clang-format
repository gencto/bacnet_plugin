# Style of bacnet-stack (native/bacnet-stack/.clang-format) for the engine.
# bp_object_table.h is generated by tool/gen_object_table.py: skip it.
#   clang-format -i $(git ls-files 'native/src/*.[ch]' \
#       ':!:native/src/bp_object_table.h')
---
BasedOnStyle: WebKit
AlignAfterOpenBracket: AlwaysBreak
BinPackArguments: true
BinPackParameters: false
PenaltyBreakBeforeFirstCallParameter: 1
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AlignEscapedNewlines: Left
AlignArrayOfStructures: None
PointerAlignment: Right
InsertBraces: true
BreakBeforeBraces: Linux
BreakBeforeBinaryOperators: None
KeepEmptyLinesAtTheStartOfBlocks: false
IndentCaseLabels: true
IndentWidth: 4
UseTab: Never
SortIncludes: false
ColumnLimit: 80
# Const always to left side.
QualifierAlignment: Left
...

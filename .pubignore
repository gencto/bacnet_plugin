# Files excluded from the published package (gitignore syntax).
# Note: when this file exists pub ignores .gitignore at the package root.

# Build outputs and tooling state
.dart_tool/
build/
coverage/
/pubspec.lock
.idea/
*.iml
.vscode/

# Development only
.agent/
.editorconfig
.gitattributes
.github/
dart_test.yaml
ffigen.yaml
native/src/.clang-format
tool/

# bacnet-stack: ship the sources compiled by hook/build.dart and the licenses
native/bacnet-stack/*
!native/bacnet-stack/src/
!native/bacnet-stack/license/
!native/bacnet-stack/README.md
!native/bacnet-stack/ports/
native/bacnet-stack/ports/*
!native/bacnet-stack/ports/win32/
native/bacnet-stack/ports/win32/Microsoft Visual Studio*/
# BACnet/SC is not compiled (needs OpenSSL), but its headers are included
# by bacapp.h (secure_connect.h) and datalink.h
native/bacnet-stack/src/bacnet/datalink/bsc/*.c
